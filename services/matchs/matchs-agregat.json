{
  "service": "Matchs",
  "aggregate": "Match",
  "schema": {
    "matchId": "string (identifiant unique)",
    "homeTeam": "string",
    "awayTeam": "string",
    "competition": "string",
    "startTime": "datetime ISO 8601",
    "status": "SCHEDULED | FINISHED",
    "odds": {
      "home": "number",
      "draw": "number",
      "away": "number"
    },
    "result": {
      "homeScore": "integer | null",
      "awayScore": "integer | null",
      "outcome": "HOME | DRAW | AWAY | null"
    },
    "version": "integer (incrémenté à chaque modification)",
    "createdAt": "datetime",
    "updatedAt": "datetime"
  },
  "example_document_mongodb": {
    "_id": "m-001",
    "matchId": "m-001",
    "homeTeam": "PSG",
    "awayTeam": "OM",
    "competition": "Ligue 1",
    "startTime": "2026-10-25T20:45:00+02:00",
    "status": "FINISHED",
    "odds": { "home": 1.80, "draw": 3.70, "away": 4.60 },
    "result": { "homeScore": 2, "awayScore": 1, "outcome": "HOME" },
    "version": 3,
    "createdAt": "2026-10-08T11:00:00+02:00",
    "updatedAt": "2026-10-25T22:40:00+02:00"
  },
  "rules": [
    "outcome est calculé à partir des scores : HOME si homeScore > awayScore, AWAY si inférieur, DRAW si égal",
    "les cotes ne sont modifiables que tant que status = SCHEDULED",
    "un match FINISHED n'est plus modifiable"
  ]
}
